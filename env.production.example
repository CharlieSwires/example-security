# Non-secret production shell/build settings. Keep real secrets in
# /etc/example-security/backend.env on each VM.
VITE_API_BASE=/ExampleSecurity
CORS_ALLOWED_ORIGINS=https://your-domain.example
FRONTEND_BASE_URL=https://your-domain.example
BACKEND_BASE_URL=https://your-domain.example/ExampleSecurity
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
