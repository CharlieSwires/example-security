MONGODB_URI=mongodb+srv://example_security_app:replace-with-url-encoded-password@replace-with-cluster.mongodb.net/example_security?retryWrites=true&w=majority
REQUIRE_EXTERNAL_SERVICES=true
INITIAL_SUPER_USERNAME=super
INITIAL_SUPER_PASSWORD=replace-with-a-long-random-bootstrap-password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8080/ExampleSecurity

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-email@example.com
MAIL_PASSWORD=replace-with-smtp-app-password
MAIL_FROM=replace-with-email@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

SSL_ENABLED=false
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Login throttling / brute-force protection
LOGIN_MAX_USER_IP_FAILURES=5
LOGIN_MAX_IP_FAILURES=25
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_MAX_ACCOUNT_REQUESTS=3
PASSWORD_RESET_MAX_IP_REQUESTS=20
PASSWORD_RESET_WINDOW_MINUTES=60
PASSWORD_RESET_LOCKOUT_MINUTES=60

SECURITY_AUDIT_PERSIST=true

SESSION_TIMEOUT=30m

SECURITY_DEBUG_REQUEST_LOGGING=false
MAX_REQUEST_BYTES=262144

# Field encryption refuses to start without both values when enabled.
# Generate the salt with: openssl rand -base64 32
FIELD_CRYPTO_ENABLED=true
FIELD_CRYPTO_PASSPHRASE=
FIELD_CRYPTO_MASTER_SALT_B64=
# Optional Google OpenID Connect login. Keep the client secret out of Git.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
