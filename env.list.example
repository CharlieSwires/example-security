# Copy this file to env.list, then edit values.
# Keep the copied env.list local; it is ignored by Git.

# Required external services. The Atlas password must be URL encoded.
MONGODB_URI=mongodb+srv://example_security_app:replace-with-url-encoded-password@replace-with-cluster.mongodb.net/example_security?retryWrites=true&w=majority
REQUIRE_EXTERNAL_SERVICES=true
INITIAL_SUPER_USERNAME=super
INITIAL_SUPER_PASSWORD=replace-with-a-long-random-bootstrap-password

CORS_ALLOWED_ORIGINS=https://localhost:5173
FRONTEND_BASE_URL=https://localhost:5173
BACKEND_BASE_URL=https://localhost:8080/ExampleSecurity
VITE_API_BASE=https://localhost:8080/ExampleSecurity

# Optional Google OpenID Connect login. Create a Web application OAuth client in
# Google Cloud and register this exact local callback:
# https://localhost:8080/ExampleSecurity/login/oauth2/code/google
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Required external SMTP service (Gmail shown; any authenticated STARTTLS provider works).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-email@example.com
MAIL_PASSWORD=replace-with-smtp-app-password
MAIL_FROM=replace-with-email@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_DEBUG=false

# TLS is terminated at the load balancer in local Docker.
SSL_ENABLED=false
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none
SESSION_COLLECTION_NAME=spring_sessions
SESSION_TIMEOUT=30m

LOGIN_MAX_USER_IP_FAILURES=5
LOGIN_MAX_IP_FAILURES=25
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_MAX_ACCOUNT_REQUESTS=3
PASSWORD_RESET_MAX_IP_REQUESTS=20
PASSWORD_RESET_WINDOW_MINUTES=60
PASSWORD_RESET_LOCKOUT_MINUTES=60
SECURITY_AUDIT_PERSIST=true
SECURITY_DEBUG_REQUEST_LOGGING=false
MAX_REQUEST_BYTES=262144

# Field-level encryption for clinical/person-identifying fields.
# Generate 14+ random words and keep them out of Git. Changing this after data is saved
# requires decrypting/rewrapping or re-encrypting existing data.
FIELD_CRYPTO_ENABLED=true
# Both values are mandatory. Generate the salt with: openssl rand -base64 32
FIELD_CRYPTO_PASSPHRASE=
FIELD_CRYPTO_MASTER_SALT_B64=

# Java regular expression for reverse proxies allowed to supply X-Forwarded-*.
# The application default trusts loopback and private Docker address ranges only.
# TRUSTED_PROXY_REGEX=
